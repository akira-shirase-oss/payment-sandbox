{
  "name": "@sandbox/ui",
  "private": true,
  "version": "0.0.0",
  "description": "Payment Sandbox's own copy of Colophon's design system (@colophon/ui, D-056 there; D-035 here), copied 2026-11-17 and pruned to what the checkout and the dashboard use: the Tailwind CSS v4 tokens (styles.css), cn, the shadcn-svelte Alert, Badge, Button, Card, Input, Label, Separator, Skeleton and Table, plus the sandbox's own outcome states and badge. Owned here; it evolves on its own.",
  "type": "module",
  "exports": {
    "./styles.css": "./src/lib/styles.css",
    "./utils": "./src/lib/utils.ts",
    "./outcome": "./src/lib/outcome.ts",
    "./money": "./src/lib/money.ts",
    "./ui/*": {
      "types": "./src/lib/components/ui/*/index.ts",
      "svelte": "./src/lib/components/ui/*/index.ts",
      "default": "./src/lib/components/ui/*/index.ts"
    },
    "./components/*": "./src/lib/components/*"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lucide/svelte": "1.62.0",
    "bits-ui": "2.20.2",
    "cn": "0.5.0",
    "mode-watcher": "1.1.0",
    "shadcn-svelte": "1.7.1",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "happy-dom": "21.0.4",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
