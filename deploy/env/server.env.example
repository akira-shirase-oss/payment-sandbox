# /etc/payment-sandbox/server.env — sandbox-server (SIMULATED MONEY ONLY). Mode 0640,
# owner root, group payment-sandbox. Every value is read once at startup; a wrong or missing
# required value stops the server with a message naming it. docs/OPERATING.md explains each.

# The shared host's profile: test control planes off (D-046); the browser-facing origins may
# be https names behind the reverse proxy (D-071).
PS_PROFILE=shared
# Listen on loopback only (D-023); the reverse proxy is the only way in.
PS_LISTEN=127.0.0.1:56080
# The runtime role ps_app (D-038), never the owner or a superuser.
PS_DATABASE_URL=postgres://ps_app:CHANGE-ME-app-password@127.0.0.1:5432/payment_sandbox
# The simulated network and its credential (at least 32 characters; the same as sim.env's).
PS_SIM_URL=http://127.0.0.1:56081
PS_SIM_TOKEN=
# The operator's token that creates projects (keep it out of shell history).
PS_BOOTSTRAP_TOKEN=
# 64 hex characters: encrypts webhook signing secrets and seals explanation cursors. Back it
# up with the database: without it, stored webhook secrets cannot be opened.
PS_SECRET_KEY=
# Loopback ports webhook receivers on this host may use (D-059); empty refuses every target.
PS_WEBHOOK_PORTS=56100-56199
# The checkout and the dashboard, each its own origin (D-029, D-061), as browsers reach them.
PS_CHECKOUT_DIR=/opt/payment-sandbox/checkout
PS_CHECKOUT_LISTEN=127.0.0.1:56083
PS_CHECKOUT_ORIGIN=https://pay.sandbox.example.com
PS_DASHBOARD_DIR=/opt/payment-sandbox/dashboard
PS_DASHBOARD_LISTEN=127.0.0.1:56084
PS_DASHBOARD_ORIGIN=https://dashboard.sandbox.example.com
# JSON logs for the journal; never carries keys, tokens or card-like input.
PS_LOG_FORMAT=json
PS_LOG=info
