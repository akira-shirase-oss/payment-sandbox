# /etc/payment-sandbox/backup.env — payment-sandbox-backup.service (SIMULATED MONEY ONLY).
# Mode 0600, owner root. Optional: these are the defaults. The database URL is migrate.env's
# (the schema owner dumps the schema it owns).
# Where backups go (root only, 0700). Copy it off the host yourself: rsync, restic, ...
PS_BACKUP_DIR=/var/backups/payment-sandbox
# How many of each kind (database dump, network store, env files) to keep.
PS_BACKUP_KEEP=14
# The network's store, as sim.env's PS_SIM_DB.
PS_SIM_DB=/var/lib/payment-sandbox/sim.redb
