# /etc/payment-sandbox/sim.env — sandbox-sim, the simulated network (SIMULATED MONEY ONLY).
# Mode 0640, owner root, group payment-sandbox.
PS_PROFILE=shared
PS_SIM_LISTEN=127.0.0.1:56081
# Its own store; back it up with the database (docs/OPERATING.md, "Backup and restore").
PS_SIM_DB=/var/lib/payment-sandbox/sim.redb
# The credential the server presents (the same value as server.env's PS_SIM_TOKEN).
PS_SIM_TOKEN=
PS_SIM_LOG=info
