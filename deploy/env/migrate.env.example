# /etc/payment-sandbox/migrate.env — migrations, as the schema's owner ps_owner (D-038).
# Mode 0600, owner root: it holds the schema owner's password, which the server's user must
# never be able to read (D-081); systemd reads it as root before starting the unit. Used by
# payment-sandbox-migrate.service only.
PS_MIGRATE_DATABASE_URL=postgres://ps_owner:CHANGE-ME-owner-password@127.0.0.1:5432/payment_sandbox
