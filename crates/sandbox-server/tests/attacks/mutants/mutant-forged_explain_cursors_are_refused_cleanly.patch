# Mutant: the explain context is not bound — the AEAD's associated data is dropped, so a
# cursor issued for one context decrypts for every other (cross-account, cross-project).
# Expected red: attacks::forged_explain_cursors_are_refused_cleanly fails without the protection.
diff --git a/crates/sandbox-server/src/cursor.rs b/crates/sandbox-server/src/cursor.rs
index 0000000..0000000 100644
--- a/crates/sandbox-server/src/cursor.rs
+++ b/crates/sandbox-server/src/cursor.rs
@@ -155,10 +155,10 @@ impl CursorKey {
         let ciphertext = self
             .cipher
             .encrypt(
                 &Nonce::from(nonce),
                 Payload {
                     msg: payload.as_bytes(),
-                    aad: context.as_bytes(),
+                    aad: b"",
                 },
             )
             .map_err(|_| SealError)?;
@@ -181,10 +181,10 @@ impl CursorKey {
         let plain = self
             .cipher
             .decrypt(
                 &Nonce::from(nonce),
                 Payload {
                     msg: ciphertext,
-                    aad: context.as_bytes(),
+                    aad: b"",
                 },
             )
             .map_err(|_| CursorError::Invalid)?;
